include research/adoption.md research/consumer.md research/ecosystem.md research/next-improvements.md
include research/sdk-roundtrip.md research/subject-graph.md research/validation.md
include scripts/check_starter.py scripts/locate_row.py scripts/read-fhirpath.cjs scripts/validate-fhir.sh
include scripts/benchmark_check.py scripts/benchmark_suite.py scripts/verify_distribution.py
