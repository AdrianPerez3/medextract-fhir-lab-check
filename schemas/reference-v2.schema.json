{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MedExtract FHIR Lab Check source reference version 2",
  "description": "Independent expected rows for one report. Row identifiers must also be unique within the report.",
  "type": "object",
  "required": ["schema_version", "report_id", "identifier_system", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "report_id": {"$ref": "#/$defs/identifier"},
    "identifier_system": {"$ref": "#/$defs/system"},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9]", "not": {"pattern": "[^A-Za-z0-9._-]"}
    },
    "system": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[\\s\\S]",
      "not": {"pattern": "[\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"}
    },
    "literal": {
      "type": "string", "minLength": 1,
      "not": {"pattern": "^[\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]|[\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]$"}
    },
    "decimalLiteral": {
      "type": "string",
      "pattern": "^[+-]?[0-9]+(\\.[0-9]+)?$",
      "not": {"pattern": "[^+0-9.-]"}
    },
    "specimen": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "required": ["system", "code"], "additionalProperties": false,
          "properties": {"system": {"$ref": "#/$defs/system"}, "code": {"$ref": "#/$defs/literal"}}
        }
      ]
    },
    "status": {"enum": [null, "registered", "preliminary", "final", "amended", "corrected", "cancelled", "entered-in-error", "unknown"]},
    "row": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/commonRow"},
        {"oneOf": [{"$ref": "#/$defs/quantity"}, {"$ref": "#/$defs/absent"}]}
      ],
      "unevaluatedProperties": false
    },
    "commonRow": {
      "type": "object", "required": ["id", "loinc", "status", "specimen"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"}, "loinc": {"$ref": "#/$defs/literal"},
        "status": {"$ref": "#/$defs/status"}, "specimen": {"$ref": "#/$defs/specimen"}
      }
    },
    "quantity": {
      "type": "object", "required": ["kind", "value", "unit", "comparator"],
      "properties": {
        "kind": {"const": "quantity"}, "value": {"$ref": "#/$defs/decimalLiteral"}, "unit": {"$ref": "#/$defs/literal"},
        "comparator": {"enum": [null, "<", ">", "<=", ">=", "≤", "≥"]},
        "display_unit": {"$ref": "#/$defs/literal"},
        "preserve_decimal_places": {"type": "boolean"}
      }
    },
    "absent": {
      "type": "object", "required": ["kind", "absent_reason"],
      "properties": {
        "kind": {"const": "absent"},
        "absent_reason": {"enum": ["unknown", "asked-unknown", "temp-unknown", "not-asked", "asked-declined", "masked", "not-applicable", "unsupported", "error", "not-a-number", "negative-infinity", "positive-infinity", "not-performed", "not-permitted"]}
      }
    }
  }
}
